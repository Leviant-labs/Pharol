# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional upstream search & extraction keys for higher rate limits.
# Leave unset to run these providers in keyless public mode automatically.
# EXA_API_KEY=""
# PARALLEL_API_KEY=""
# TAVILY_API_KEY=""
# FIRECRAWL_API_KEY=""
# KEENABLE_API_KEY=""
# TINYFISH_API_KEY=""


# Google/Bing/DDG default to in-process browser impersonation.
# Set to fetch only for an explicit ordinary-HTTP comparison.
# PHAROL_WEB_TRANSPORT="fetch"

# Required for saving user API keys; generate with: openssl rand -hex 32
# Keep this secret identical across replicas and outside source control.
# PHAROL_CREDENTIAL_SECRET=""
# Public HTTPS origin when running behind a reverse proxy:
# PHAROL_ORIGIN="https://pharol.example"
# Users can add a free OpenAlex key through Privacy & Preferences → Keys & Hosts.
# OPENALEX_API_KEY="" # Optional operator-provided default only
