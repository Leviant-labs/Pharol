# Pharol environment. Every entry is optional; the app runs keyless without it.

# Optional AI synthesis for /api/answer. Search, reader, verticals and MCP do
# not need it; without a key the answer box uses the deterministic path.
# GEMINI_API_KEY=""

# Operator-wide upstream keys. Each unset value keeps that provider in its
# keyless public mode where one exists. Individuals can also save their own
# keys in Privacy & Preferences → Keys & Hosts; a saved key wins over these.
# EXA_API_KEY=""
# PARALLEL_API_KEY=""
# TAVILY_API_KEY=""
# FIRECRAWL_API_KEY=""
# KEENABLE_API_KEY=""
# TINYFISH_API_KEY=""
# SERPER_API_KEY=""          # optional BYOK Google Web/News/Images/Videos
# BRAVE_API_KEY=""           # optional BYOK Brave Web/News/Images/Videos
# CONTEXT7_API_KEY=""
# SEMANTIC_SCHOLAR_API_KEY=""
# CORE_API_KEY=""
# OPENALEX_API_KEY=""
# GITHUB_TOKEN=""            # raises GitHub search rate limits

# Google/Bing/DuckDuckGo default to in-process TLS impersonation via impit.
# Set to fetch only for an explicit ordinary-HTTP comparison.
# PHAROL_WEB_TRANSPORT="fetch"

# Required for saving user API keys: 64 hex characters (openssl rand -hex 32).
# Keep it identical across replicas and outside source control.
# PHAROL_CREDENTIAL_SECRET=""

# Public HTTPS origin when a reverse proxy terminates TLS:
# PHAROL_ORIGIN="https://pharol.example"
